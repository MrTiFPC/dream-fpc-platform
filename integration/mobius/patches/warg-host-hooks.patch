+		{
+			final Class<?> serviceClass = Class.forName(HYBRID_PARTY_SERVICE_CLASS);
+			final Method getInstance = serviceClass.getMethod("getInstance");
+			return getInstance.invoke(null);
+		}
+		catch (ReflectiveOperationException | IllegalArgumentException e)
+		{
+			return null;
+		}
+	}
+
+	private List<HybridPartyMember> normalizeHybridPartyMembers(Object result)
+	{
+		if (result == null)
+		{
+			return List.of();
+		}
+
+		final List<HybridPartyMember> members = new ArrayList<>();
+		if (result instanceof Iterable<?> iterable)
+		{
+			for (Object entry : iterable)
+			{
+				if (entry instanceof HybridPartyMember hybridMember)
+				{
+					members.add(hybridMember);
+				}
+			}
+			return members;
+		}
+
+		if (result.getClass().isArray())
+		{
+			final Object[] array = (Object[]) result;
+			for (Object entry : array)
+			{
+				if (entry instanceof HybridPartyMember hybridMember)
+				{
+					members.add(hybridMember);
+				}
+			}
+		}
+		return members;
